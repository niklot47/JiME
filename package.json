{
  "name": "jime-reborn",
  "private": true,
  "version": "0.1.0",
  "description": "Fan-made companion engine for Journeys in Middle-earth (FFG content is imported locally, never shipped)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "test": "pnpm -r --filter \"./packages/*\" test",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "packs:build": "node scripts/run-python.mjs tools/importer/make_pack.py",
    "packs:validate": "pnpm --filter @jime/content-tools validate",
    "fuzz": "node scripts/run-python.mjs engine-py/fuzz_all.py 10",
    "dev": "pnpm --filter @jime/app dev",
    "tauri": "pnpm --filter @jime/app tauri"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "supportedArchitectures": { "os": ["win32", "linux"], "cpu": ["x64"] },
    "onlyBuiltDependencies": ["esbuild"]
  }
}
