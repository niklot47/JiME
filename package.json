{
  "name": "jime-reborn",
  "private": true,
  "version": "0.1.0",
  "description": "Fan-made companion engine for Journeys in Middle-earth (FFG content is imported locally, never shipped)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "pnpm -r --filter \"./packages/*\" test",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "packs:build": "node scripts/run-python.mjs tools/importer/export_tiles.py && node scripts/run-python.mjs tools/importer/make_pack.py && node scripts/run-python.mjs tools/importer/export_tile_art.py && node scripts/run-python.mjs tools/importer/export_fonts.py",
    "packs:validate": "pnpm --filter @jime/content-tools validate",
    "fuzz": "node packages/engine/cli/fuzz-all.ts 10",
    "dev": "pnpm --filter @jime/app dev",
    "tauri": "pnpm --filter @jime/app tauri",
    "fuzz:py": "node scripts/run-python.mjs engine-py/fuzz_all.py 10",
    "parity": "node packages/engine/cli/parity.ts all 0 5",
    "play": "node packages/engine/cli/play.ts",
    "play:bot": "node packages/engine/cli/run.ts",
    "mapgen": "node packages/engine/cli/mapgen.ts",
    "verify:maps": "node packages/engine/cli/verify-saves.ts",
    "verify:board": "node packages/engine/cli/board-check.ts 2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "win32",
        "linux"
      ],
      "cpu": [
        "x64"
      ]
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
