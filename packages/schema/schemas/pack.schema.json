{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jime.local/schemas/pack.schema.json",
  "title": "JiME pack manifest (pack.json)",
  "type": "object",
  "required": ["formatVersion", "id", "version", "priority", "contents"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "name": { "$ref": "#/definitions/localized" },
    "description": { "$ref": "#/definitions/localized" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "priority": { "type": "integer", "minimum": -1000, "maximum": 1000, "description": "Higher priority overrides lower on conflicting keys/ids" },
    "origin": { "enum": ["ffg-import", "community", "generated", "user"], "description": "ffg-import packs are built locally and must never be redistributed" },
    "authors": { "type": "array", "items": { "type": "string" } },
    "dependencies": {
      "type": "object",
      "description": "pack id -> required version (exact or ^/~ range)",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
      "additionalProperties": { "type": "string" }
    },
    "contents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/content" }
    }
  },
  "definitions": {
    "localized": {
      "oneOf": [
        { "type": "string" },
        { "type": "object", "additionalProperties": { "type": "string" }, "minProperties": 1 }
      ]
    },
    "relPath": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\:]+$" },
    "content": {
      "type": "object",
      "required": ["type", "path"],
      "properties": {
        "type": { "enum": ["scenario", "lang", "voice", "theme", "models", "rules"] },
        "path": { "$ref": "#/definitions/relPath" },
        "lang": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["lang", "voice"] } } }, "then": { "required": ["lang"] } }
      ],
      "additionalProperties": false
    }
  }
}
