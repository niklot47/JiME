{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jime.local/schemas/db.schema.json",
  "title": "JiME content database (models, standard tiles, global variables)",
  "type": "object",
  "required": ["format", "formatVersion", "models", "standardTiles", "globals"],
  "additionalProperties": false,
  "definitions": {
    "tileGeometry": {
      "type": "object",
      "required": ["code", "hexes", "spaces", "edges"],
      "properties": {
        "code": { "type": "string" },
        "hexes": { "type": "array", "items": { "type": "object", "required": ["x", "y", "z", "space"] } },
        "spaces": { "type": "array", "items": { "type": "object", "required": ["traits", "hexes"] } },
        "edges": { "type": "array", "items": { "type": "object", "required": ["hex", "dir", "traits", "open"] } }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "jime-db" },
    "formatVersion": { "const": 1 },
    "models": {
      "type": "object",
      "description": "Model type (AdventureModel, HeroModel, ...) -> id -> fields",
      "additionalProperties": { "type": "object", "additionalProperties": { "type": "object" } }
    },
    "standardTiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["model", "spaces"],
        "properties": {
          "model": { "type": "object" },
          "spaces": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["traits", "connected"],
              "properties": {
                "traits": { "type": "integer" },
                "connected": { "type": "array", "items": { "type": "integer" } }
              }
            }
          }
        }
      }
    },
    "tiles": {
      "type": "array",
      "description": "Standard tiles in FFG StandardTiles bucket order, with geometry for the map generator",
      "items": { "$ref": "#/definitions/tileGeometry" }
    },
    "productOrder": { "type": "array", "items": { "type": "integer" }, "description": "JIME_Database.Products order" },
    "globals": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": { "enum": ["bool", "int", "float", "string", "vector3", "array"] },
          "value": {}
        }
      }
    }
  }
}
